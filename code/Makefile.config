# Shared configuration for project makefiles.

# Project root is resolved from this file location.
PROJECT_ROOT ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)

# Toolchain
CC ?= gcc
CPPFLAGS ?=
CFLAGS ?= -std=c11 -Wall -Wextra -Wpedantic -O2
LDFLAGS ?=
LDLIBS ?= -lsodium

# Layout
SRC_DIR ?= $(PROJECT_ROOT)/code/src
INCLUDE_DIR ?= $(PROJECT_ROOT)/code/include
DEMONSTRATIONS_DIR ?= $(PROJECT_ROOT)/code
TESTS_DIR ?= $(PROJECT_ROOT)/code/tests
TEST_VECTORS_DIR ?= $(PROJECT_ROOT)/code/tests/vectors
BUILD_DIR ?= $(PROJECT_ROOT)/.local/build
TEMP_DIR ?= $(PROJECT_ROOT)/.local/scratch
